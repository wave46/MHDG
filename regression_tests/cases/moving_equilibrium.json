{
  "schema_version": 2,
  "description": "Transient feedback, moving equilibrium, timestep recovery and fixed-field adaptive ramp",
  "files": {
    "required": {
      "geometry": "geometry.geo",
      "parameters": "param.txt",
      "impurity_configuration": "impurity_model.nml",
      "equilibrium_series": "equilibrium.h5",
      "control_puff": "puff.h5",
      "control_target_density": "target_density.h5",
      "control_zeff": "zeff.h5",
      "control_impurity_concentration": "impurity_concentration.h5",
      "short_control_puff": "short_puff.h5",
      "short_control_target_density": "short_target_density.h5"
    },
    "optional": {
      "bootstrap": "bootstrap.json",
      "mode1_reference": "reference_mode1.h5",
      "mode1_restart_step6": "restart_mode1_step6.h5",
      "quasisteady_reference": "reference_quasisteady.h5",
      "mode0_short_reference": "reference_mode0_short.h5",
      "mode2_short_reference": "reference_mode2_short.h5",
      "ramp_target_density": "ramp_target_density.h5",
      "recovery_reference": "reference_recovery.h5",
      "recovery_restart": "restart_recovery.h5",
      "ramp_reference": "reference_ramp.h5"
    }
  },
  "parameter_namelists": {
    "max_divergence_refinements": "adapt_lst",
    "max_oscillation_refinements": "adapt_lst"
  },
  "workflows": {
    "mode1_short": {
      "description": "Two 80 ms puff-feedback advances for MPI agreement",
      "type": "warm_same_state",
      "layout": "mpi4_omp4",
      "inputs": ["geometry", "bootstrap", "control_puff", "control_target_density"],
      "parameters": "parameters",
      "restart": "bootstrap",
      "impurity_configuration": "impurity_configuration",
      "moving_equilibrium": {
        "series": "equilibrium_series",
        "time_step_s": 0.08,
        "controls": {
          "puff": "control_puff", "target_density": "control_target_density",
          "zeff": "control_zeff", "impurity_concentration": "control_impurity_concentration"
        },
        "topology": {"first_completed": "limited", "last_completed": "limited"},
        "controller_scales": {
          "puff": 1e21, "n_li": 1e19,
          "feedback_integral_error": 1e19, "feedback_previous_error": 1e19,
          "recycling": 1.0, "recycling_pump": 1.0
        }
      },
      "parameter_overrides": {
        "stab": 2,
        "newton_formulation": "absolute",
        "newton_convergence": "update",
        "residual_diagnostics_mode": "off",
        "bohm_momentum_always_include_diffusion": true,
        "recycle_plasma_diffusion": false,
        "evaluator": 0,
        "quant_ind": 1,
        "tol_est": 0.005,
        "osc_tol": -3.0,
        "flux_limiter": false,
        "time_mode": "legacy", "dt_reduce_on_failure": false,
        "dt_grow_on_easy": false, "newton_predictor": false,
        "nts": 2, "saveNR": false, "target_variable": 1, "compute_from_flux": true,
        "adaptivity": true, "div_adapt": true, "osc_adapt": true,
        "check_neutral_positivity": true, "time_adapt": false,
        "max_divergence_refinements": 0, "max_oscillation_refinements": 1,
        "feedback_propotional_gain": 240.0,
        "feedback_integral_gain": 24.0, "feedback_derivative_gain": 9.6
      },
      "comparison": {
        "method": "mesh_independent", "profile": "adaptive_reference",
        "direct_profile": "feature_converged", "cross_layout_profile": "fixed_cross_layout"
      }
    },
    "mode1": {
      "extends": "mode1_short",
      "description": "Seven 80 ms puff-feedback advances through a limited-to-diverted transition",
      "reference": "mode1_reference",
      "outputs": ["mode1_reference"],
      "checkpoint_outputs": {"mode1_restart_step6": 6},
      "parameter_overrides": {"nts": 7},
      "moving_equilibrium": {
        "series": "equilibrium_series", "time_step_s": 0.08,
        "controls": {
          "puff": "control_puff", "target_density": "control_target_density",
          "zeff": "control_zeff", "impurity_concentration": "control_impurity_concentration"
        },
        "topology": {"first_completed": "limited", "last_completed": "lower_single_null"},
        "controller_scales": {
          "puff": 1e21, "n_li": 1e19,
          "feedback_integral_error": 1e19, "feedback_previous_error": 1e19,
          "recycling": 1.0, "recycling_pump": 1.0
        }
      }
    },
    "mode1_restart": {
      "extends": "mode1",
      "description": "Restart at step six, repeat step seven and add ten held-input 80 ms advances",
      "restart": "mode1_restart_step6",
      "reference": "quasisteady_reference",
      "outputs": ["quasisteady_reference"],
      "checkpoint_outputs": {},
      "parameter_overrides": {"nts": 17},
      "moving_equilibrium": {
        "series": "equilibrium_series", "time_step_s": 0.08,
        "restart_check": {"step": 7, "reference": "mode1_reference"},
        "controls": {
          "puff": "control_puff", "target_density": "control_target_density",
          "zeff": "control_zeff", "impurity_concentration": "control_impurity_concentration"
        },
        "topology": {"first_completed": "lower_single_null", "last_completed": "lower_single_null"},
        "controller_scales": {
          "puff": 1e21, "n_li": 1e19,
          "feedback_integral_error": 1e19, "feedback_previous_error": 1e19,
          "recycling": 1.0, "recycling_pump": 1.0
        }
      }
    },
    "recovery": {
      "extends": "mode1_short",
      "description": "Run the full 0 to 0.50 s discharge with prescribed 100 ms targets and temporal recovery",
      "comparison": {
        "method": "mesh_independent", "profile": "adaptive_reference",
        "direct_profile": "me_recovery_converged", "cross_layout_profile": "fixed_cross_layout"
      },
      "reference": "recovery_reference",
      "outputs": [
        "recovery_reference"
      ],
      "parameter_overrides": {
        "feedback_propotional_gain": 300.0,
        "feedback_integral_gain": 30.0,
        "feedback_derivative_gain": 12.0,
        "time_mode": "prescribed",
        "time_units": "seconds",
        "t_final": 0.5,
        "dt_reduce_on_failure": true,
        "dt_min": 1e-06
      },
      "moving_equilibrium": {
        "series": "equilibrium_series",
        "time_step_s": 0.1,
        "controls": {
          "puff": "control_puff",
          "target_density": "control_target_density",
          "zeff": "control_zeff",
          "impurity_concentration": "control_impurity_concentration"
        },
        "topology": {
          "first_completed": "limited",
          "last_completed": "lower_single_null"
        },
        "controller_scales": {
          "puff": 1e+21,
          "n_li": 1e+19,
          "feedback_integral_error": 1e+19,
          "feedback_previous_error": 1e+19,
          "recycling": 1.0,
          "recycling_pump": 1.0
        },
        "acceptance_checks": {
          "rejection": true
        }
      },
      "restart": "bootstrap",
      "checkpoint_outputs": {
        "recovery_restart": "first_intermediate"
      }
    },
    "recovery_restart": {
      "extends": "recovery",
      "description": "Restart at the first accepted intermediate time and replay the rest of the 0.50 s discharge",
      "reference": "recovery_reference",
      "outputs": [],
      "moving_equilibrium": {
        "series": "equilibrium_series",
        "time_step_s": 0.1,
        "controls": {
          "puff": "control_puff",
          "target_density": "control_target_density",
          "zeff": "control_zeff",
          "impurity_concentration": "control_impurity_concentration"
        },
        "topology": {
          "last_completed": "lower_single_null"
        },
        "controller_scales": {
          "puff": 1e+21,
          "n_li": 1e+19,
          "feedback_integral_error": 1e+19,
          "feedback_previous_error": 1e+19,
          "recycling": 1.0,
          "recycling_pump": 1.0
        },
        "acceptance_checks": {
          "intermediate_restart": true
        }
      },
      "restart": "recovery_restart",
      "checkpoint_outputs": {}
    },
    "adaptive_ramp": {
      "description": "Fixed-field density ramp with timestep growth and guarded Newton prediction",
      "restart": "quasisteady_reference",
      "moving_equilibrium": {
        "series": "equilibrium_series",
        "time_step_s": 0.08,
        "controls": {
          "target_density": "ramp_target_density"
        },
        "topology": {
          "first_completed": "lower_single_null",
          "last_completed": "lower_single_null"
        },
        "controller_scales": {
          "puff": 1e+21,
          "n_li": 1e+19,
          "feedback_integral_error": 1e+19,
          "feedback_previous_error": 1e+19,
          "recycling": 1.0,
          "recycling_pump": 1.0
        },
        "equilibrium_time_s": 0.56,
        "acceptance_checks": {
          "growth": true,
          "prediction": true,
          "final_clipping": true
        }
      },
      "parameter_overrides": {
        "time_mode": "adaptive",
        "dt_reduce_on_failure": true,
        "dt_grow_on_easy": true,
        "newton_predictor": true,
        "time_units": "seconds",
        "t_final": 2.3,
        "dt_min": 1e-06,
        "dt_max": 0.16,
        "dt_growth_factor": 1.2,
        "dt_growth_easy_steps": 2,
        "newton_predictor_rate_limit": 0.35,
        "Zeff": 1.0
      },
      "extends": "mode1_short",
      "reference": "ramp_reference",
      "outputs": [
        "ramp_reference"
      ]
    },
    "mode2_short": {
      "extends": "mode1_short",
      "description": "Two 80 ms recycling-feedback advances with off-knot puff and density targets",
      "reference": "mode2_short_reference",
      "outputs": ["mode2_short_reference"],
      "parameter_overrides": {
        "target_variable": 2,
        "feedback_propotional_gain": 2e-20,
        "feedback_integral_gain": 2e-21, "feedback_derivative_gain": 8e-22
      },
      "moving_equilibrium": {
        "series": "equilibrium_series", "time_step_s": 0.08,
        "controls": {
          "puff": "short_control_puff", "target_density": "short_control_target_density",
          "zeff": "control_zeff", "impurity_concentration": "control_impurity_concentration"
        },
        "topology": {"first_completed": "limited", "last_completed": "limited"},
        "controller_scales": {
          "puff": 1e21, "n_li": 1e19,
          "feedback_integral_error": 1e19, "feedback_previous_error": 1e19,
          "recycling": 1.0, "recycling_pump": 1.0
        }
      }
    },
    "mode0_short": {
      "extends": "mode2_short",
      "description": "Two 80 ms prescribed-puff advances with off-knot interpolation",
      "reference": "mode0_short_reference",
      "outputs": ["mode0_short_reference"],
      "parameter_overrides": {
        "target_variable": 0, "feedback_propotional_gain": 240.0,
        "feedback_integral_gain": 24.0, "feedback_derivative_gain": 9.6
      },
      "moving_equilibrium": {
        "series": "equilibrium_series", "time_step_s": 0.08,
        "controls": {
          "puff": "short_control_puff", "target_density": "short_control_target_density",
          "zeff": "control_zeff", "impurity_concentration": "control_impurity_concentration"
        },
        "topology": {"first_completed": "limited", "last_completed": "limited"},
        "controller_scales": {"puff": 1e21, "recycling": 1.0, "recycling_pump": 1.0}
      }
    }
  }
}
