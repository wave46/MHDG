{
  "schema_version": 2,
  "parameter_namelists": {
    "balance_diagnostics_mode": "utils_lst",
    "neutral_wall_sources_in_elements": "switch_lst",
    "neutral_perpendicular_diffusion": "switch_lst",
    "neutral_flux_limiter_save_2d": "switch_lst",
    "neutral_flux_limiter_mode": "phys_lst",
    "neutral_flux_limiter_tn_source": "phys_lst",
    "neutral_flux_limiter_tn_eV": "phys_lst",
    "neutral_flux_limiter_eps": "phys_lst",
    "neutral_flux_limiter_fs_fraction": "phys_lst",
    "neutral_flux_limiter_fs_flux_min": "phys_lst"
  },
  "sequences": {
    "bootstrap": [
      {
        "id": "time_init",
        "parameters": "cold_fixed_time_init_parameters",
        "newton_check": "finite_only",
        "parameter_overrides": {
          "steady": false,
          "read_gmsh": true,
          "readMeshFromSol": false,
          "psdtime": false,
          "nrp": 3,
          "dt0": 1000.0,
          "nts": 10
        }
      },
      {
        "id": "diffred",
        "parameters": "cold_fixed_time_init_parameters",
        "parameter_overrides": {
          "steady": false,
          "read_gmsh": false,
          "readMeshFromSol": true,
          "psdtime": true,
          "nrp": 40,
          "dt0": 3000000000.0,
          "nts": 1
        }
      },
      {
        "id": "steady",
        "parameters": "cold_fixed_time_init_parameters",
        "parameter_overrides": {
          "steady": true,
          "read_gmsh": false,
          "readMeshFromSol": true,
          "psdtime": false,
          "nrp": 40,
          "adaptivity": false
        }
      }
    ],
    "cold_bootstrap": [
      {
        "id": "time_init",
        "parameters": "cold_fixed_time_init_parameters",
        "newton_check": "finite_only"
      },
      {
        "id": "diffusion_reduction",
        "parameters": "cold_fixed_diffusion_reduction_parameters"
      }
    ],
    "transport_continuation": [
      {
        "id": "continuation_01",
        "parameters": "cold_fixed_continuation_01_parameters",
        "transport": "cold_fixed_continuation_01_transport_configuration"
      },
      {
        "id": "continuation_02",
        "parameters": "cold_fixed_continuation_02_parameters",
        "transport": "cold_fixed_continuation_02_transport_configuration"
      },
      {
        "id": "continuation_03",
        "parameters": "cold_fixed_continuation_03_parameters",
        "transport": "cold_fixed_continuation_03_transport_configuration"
      },
      {
        "id": "continuation_04",
        "parameters": "cold_fixed_continuation_04_parameters",
        "transport": "cold_fixed_continuation_04_transport_configuration"
      },
      {
        "id": "continuation_05",
        "parameters": "cold_fixed_continuation_05_parameters",
        "transport": "cold_fixed_continuation_05_transport_configuration"
      }
    ]
  },
  "workflows": {
    "plasma_baseline": {
      "inputs": ["geometry", "equilibrium_magnetic_field", "equilibrium_current_density"],
      "impurity_configuration": "impurity_configuration",
      "layout": "mpi4_omp4",
      "parameter_overrides": {
        "compute_from_flux": true,
        "transport_1d": false,
        "impurity_radiation": true,
        "diff_n": 16.0,
        "diff_u": 16.0,
        "diff_e": 16.0,
        "diff_ee": 16.0,
        "tNR": 0.0002,
        "rest_adapt": false
      }
    },
    "bootstrap_adaptive": {
      "extends": "plasma_baseline",
      "type": "staged_adaptive_mesh",
      "description": "Initialize, reduce diffusion and converge at 16 m2/s with W radiation and transport off",
      "mesh": "coarse_mesh",
      "reference": "bootstrap_reference",
      "outputs": ["bootstrap_reference"],
      "comparison": {
        "method": "mesh_independent",
        "profile": "adaptive_reference",
        "stage_profile": "adaptive_reference",
        "direct_profile": "cold_fixed_reference",
        "direct_stage_profile": "fixed_stage_reference"
      },
      "parameter_overrides": {"adaptivity": true},
      "adaptive_stages": ["time_init", "diffred"],
      "stages": ["bootstrap"]
    },
    "bootstrap_fixed": {
      "extends": "bootstrap_adaptive",
      "type": "staged_fixed_mesh",
      "description": "Initialize fresh plasma on the accepted adaptive final mesh, then converge at 16 m2/s",
      "mesh": "bootstrap_mesh",
      "outputs": [],
      "adaptive_stages": [],
      "parameter_overrides": {"adaptivity": false},
      "comparison": {
        "method": "fixed_hdf5",
        "profile": "cold_fixed_reference",
        "stage_profile": "fixed_stage_reference"
      }
    },
    "baseline_warm": {
      "extends": "plasma_baseline",
      "type": "warm_same_state",
      "description": "Reconverge the transport-off bootstrap with W radiation at 16 m2/s",
      "parameters": "cold_fixed_time_init_parameters",
      "restart": "bootstrap_reference",
      "reference": "baseline_reference",
      "outputs": ["baseline_reference"],
      "comparison": {
        "method": "fixed_hdf5",
        "profile": "fixed_same_layout",
        "cross_layout_profile": "fixed_cross_layout"
      },
      "parameter_overrides": {
        "steady": true,
        "read_gmsh": false,
        "readMeshFromSol": true,
        "psdtime": false,
        "nrp": 40,
        "adaptivity": false
      }
    },
    "transport": {
      "extends": "baseline_warm",
      "description": "Enable transport directly from the transport-off bootstrap and converge",
      "transport": "transport_configuration",
      "reference": "transport_reference",
      "outputs": ["transport_reference"],
      "parameter_overrides": {"transport_1d": true}
    },
    "transport_short": {
      "extends": "transport",
      "description": "Run two Newton iterations enabling transport from the same transport-off bootstrap",
      "reference": "transport_short_reference",
      "outputs": ["transport_short_reference"],
      "parameter_overrides": {"nrp": 2},
      "comparison": {
        "method": "fixed_hdf5",
        "profile": "race_step",
        "cross_layout_profile": "race_step"
      }
    },
    "stored_field": {
      "extends": "baseline_warm",
      "description": "Converge using the stored magnetic/current fields with an independent reference",
      "reference": "stored_field_reference",
      "outputs": ["stored_field_reference"],
      "parameter_overrides": {"compute_from_flux": false}
    },
    "warm": {
      "type": "warm_same_state",
      "description": "Reconverge an unchanged steady restart on the fixed mesh",
      "parameters": "warm_parameters",
      "transport": "transport_configuration",
      "inputs": [
        "geometry",
        "equilibrium_magnetic_field",
        "equilibrium_current_density"
      ],
      "impurity_configuration": "impurity_configuration",
      "layout": "mpi4_omp4",
      "restart": "warm_restart",
      "reference": "warm_reference",
      "comparison": {
        "method": "fixed_hdf5",
        "profile": "fixed_same_layout",
        "cross_layout_profile": "fixed_cross_layout"
      },
      "parameter_overrides": {
        "compute_from_flux": true
      }
    },
    "cold_fixed": {
      "type": "staged_fixed_mesh",
      "description": "Reach the canonical state from analytical initialization on the fixed mesh",
      "inputs": ["geometry", "equilibrium_magnetic_field", "equilibrium_current_density"],
      "impurity_configuration": "impurity_configuration",
      "mesh": "mesh",
      "reference": "warm_reference",
      "layout": "mpi4_omp4",
      "comparison": {
        "method": "fixed_hdf5",
        "profile": "cold_fixed_reference",
        "cross_layout_profile": "cold_fixed_reference",
        "stage_profile": "fixed_stage_reference"
      },
      "parameter_overrides": {
        "compute_from_flux": true,
        "rest_adapt": false
      },
      "stages": ["cold_bootstrap", "transport_continuation"]
    },
    "cold_adaptive": {
      "extends": "cold_fixed",
      "type": "staged_adaptive_mesh",
      "description": "Repeat the cold workflow with early-stage mesh adaptation",
      "mesh": "coarse_mesh",
      "comparison": {
        "method": "mesh_independent",
        "profile": "adaptive_reference",
        "stage_profile": "adaptive_reference",
        "direct_profile": "cold_fixed_reference",
        "direct_stage_profile": "fixed_stage_reference"
      },
      "adaptive_stages": ["time_init", "diffusion_reduction"]
    },
    "cold_step_fixed": {
      "type": "staged_fixed_mesh",
      "description": "Run two Newton iterations on the coarse mesh without adaptation",
      "inputs": ["geometry", "equilibrium_magnetic_field", "equilibrium_current_density"],
      "mesh": "coarse_mesh",
      "impurity_configuration": "impurity_configuration",
      "layout": "serial_omp1",
      "comparison": {
        "method": "fixed_hdf5",
        "profile": "race_step",
        "cross_layout_profile": "race_step",
        "stage_profile": "race_step"
      },
      "parameter_overrides": {
        "compute_from_flux": true,
        "adaptivity": false,
        "rest_adapt": false,
        "nrp": 2
      },
      "stages": [
        {
          "id": "single_step",
          "parameters": "cold_fixed_time_init_parameters",
          "parameter_overrides": {
            "steady": false,
            "saveNR": false,
            "time_adapt": false,
            "NR_adapt": false,
            "div_adapt": false,
            "osc_adapt": false,
            "nts": 1
          }
        }
      ]
    },
    "cold_step_adaptive": {
      "extends": "cold_step_fixed",
      "type": "staged_adaptive_mesh",
      "description": "Run two Newton iterations with one coarse-mesh adaptation pass",
      "parameter_overrides": {
        "adaptivity": true
      },
      "adaptive_stages": ["single_step"]
    }
  }
}
