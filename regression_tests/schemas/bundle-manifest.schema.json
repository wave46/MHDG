{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wave46/MHDG/develop/regression_tests/schemas/bundle-manifest.schema.json",
  "title": "MHDG external regression case bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_version",
    "artifacts",
    "case_data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "bundle_version": {
      "type": "string",
      "minLength": 1
    },
    "bundle_class": {
      "type": "string",
      "enum": [
        "candidate",
        "golden"
      ]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    },
    "case_data": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/case_data"
      }
    }
  },
  "$defs": {
    "case_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "roles"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string"
        },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Identifier of an entry in the top-level artifacts registry"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
          "description": "POSIX-style path relative to the bundle root"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "enum": [
            "application/x-hdf5",
            "application/x-gmsh",
            "application/json",
            "text/plain"
          ]
        },
        "description": {
          "type": "string"
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
