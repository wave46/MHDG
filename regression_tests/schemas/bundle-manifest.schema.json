{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wave46/MHDG/develop/regression_tests/schemas/bundle-manifest.schema.json",
  "title": "MHDG external regression bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_version",
    "bundle_class",
    "created_utc",
    "case_id",
    "roles",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "bundle_id": {
      "$ref": "#/$defs/identifier"
    },
    "bundle_version": {
      "type": "string",
      "minLength": 1
    },
    "bundle_class": {
      "enum": [
        "candidate",
        "golden"
      ]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "case_id": {
      "$ref": "#/$defs/identifier"
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/identifier"
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "enum": [
            "application/x-hdf5",
            "application/x-gmsh",
            "application/json",
            "text/plain"
          ]
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
