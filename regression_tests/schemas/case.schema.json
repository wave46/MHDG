{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wave46/MHDG/develop/regression_tests/schemas/case.schema.json",
  "title": "MHDG regression case declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "workflows"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "description": {
      "$ref": "#/$defs/description"
    },
    "files": {
      "$ref": "#/$defs/files"
    },
    "workflows": {
      "$ref": "#/$defs/workflows"
    },
    "parameter_namelists": {
      "$ref": "#/$defs/parameter_namelists"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "filename": {
      "type": "string",
      "pattern": "^(?!\\.\\.?$)[^/\\\\]+$"
    },
    "identifier_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/file_group"
        },
        "optional": {
          "$ref": "#/$defs/file_group"
        }
      }
    },
    "file_group": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/filename"
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "description": {
          "$ref": "#/$defs/description"
        },
        "extends": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "$ref": "#/$defs/identifier"
        },
        "inputs": {
          "$ref": "#/$defs/identifier_list"
        },
        "layout": {
          "$ref": "#/$defs/identifier"
        },
        "mesh": {
          "$ref": "#/$defs/identifier"
        },
        "parameters": {
          "$ref": "#/$defs/identifier"
        },
        "transport": {
          "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        },
        "restart": {
          "$ref": "#/$defs/identifier"
        },
        "reference": {
          "$ref": "#/$defs/identifier"
        },
        "outputs": {
          "$ref": "#/$defs/identifier_list"
        },
        "impurity_configuration": {
          "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        },
        "parameter_overrides": {
          "$ref": "#/$defs/parameter_overrides"
        },
        "transport_overrides": {
          "$ref": "#/$defs/parameter_overrides"
        },
        "adaptive_stages": {
          "$ref": "#/$defs/identifier_list"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/identifier"
              },
              {
                "$ref": "#/$defs/stage"
              }
            ]
          }
        },
        "stage_overrides": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/stage_changes"
          }
        },
        "parameter_namelists": {
          "$ref": "#/$defs/parameter_namelists"
        },
        "require_refinement": {
          "type": "boolean"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "$ref": "#/$defs/identifier"
        },
        "profile": {
          "$ref": "#/$defs/identifier"
        },
        "cross_layout_profile": {
          "$ref": "#/$defs/identifier"
        },
        "direct_profile": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "stage": {
      "$ref": "#/$defs/stage_fields",
      "required": [
        "id"
      ]
    },
    "parameter_overrides": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "boolean",
          "number",
          "string"
        ]
      }
    },
    "workflows": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workflow"
      }
    },
    "stage_changes": {
      "$ref": "#/$defs/stage_fields",
      "not": {
        "required": [
          "id"
        ]
      }
    },
    "workflow_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workflows"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "workflows": {
          "$ref": "#/$defs/workflows"
        },
        "sequences": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/stage"
            }
          }
        },
        "parameter_namelists": {
          "$ref": "#/$defs/parameter_namelists"
        }
      }
    },
    "stage_fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "parameters": {
          "$ref": "#/$defs/identifier"
        },
        "transport": {
          "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        },
        "parameter_overrides": {
          "$ref": "#/$defs/parameter_overrides"
        },
        "transport_overrides": {
          "$ref": "#/$defs/parameter_overrides"
        },
        "newton_check": {
          "enum": [
            "bounded",
            "finite_only"
          ]
        },
        "parameter_namelists": {
          "$ref": "#/$defs/parameter_namelists"
        }
      }
    },
    "parameter_namelists": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      }
    }
  }
}
