{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wave46/MHDG/develop/regression_tests/schemas/reference-matrix.schema.json",
  "title": "MHDG staged golden-reference matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_utc",
    "case_id",
    "suite_id",
    "suite_run_id",
    "source_bundle",
    "tracked_reference",
    "references"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "suite_id": {
      "$ref": "#/$defs/id"
    },
    "suite_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_version"
      ],
      "properties": {
        "bundle_id": {
          "$ref": "#/$defs/id"
        },
        "bundle_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tracked_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "revision"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_id",
          "layout_id",
          "stage_id",
          "artifact_id"
        ],
        "properties": {
          "workflow_id": {
            "$ref": "#/$defs/id"
          },
          "layout_id": {
            "$ref": "#/$defs/id"
          },
          "stage_id": {
            "$ref": "#/$defs/id"
          },
          "artifact_id": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
