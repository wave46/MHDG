{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wave46/MHDG/develop/regression_tests/schemas/suites.schema.json",
  "title": "MHDG regression suites",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suites"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suites": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/suite"
      }
    }
  },
  "$defs": {
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "case_id",
        "layouts"
      ],
      "oneOf": [
        {
          "required": [
            "workflow_id"
          ],
          "not": {
            "required": [
              "workflow_ids"
            ]
          }
        },
        {
          "required": [
            "workflow_ids"
          ],
          "not": {
            "required": [
              "workflow_id"
            ]
          }
        }
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "workflow_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "workflow_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "layouts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    }
  }
}
