{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wave46/MHDG/develop/regression_tests/schemas/suites.schema.json",
  "title": "MHDG regression suites",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "defaults",
    "suites"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "suites": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/suite"
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "layout"
      ],
      "properties": {
        "case": {
          "$ref": "#/$defs/identifier"
        },
        "layout": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "checks"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "include": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "suite"
              ],
              "properties": {
                "suite": {
                  "$ref": "#/$defs/identifier"
                },
                "case": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "identifier_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "workflows"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "case": {
          "$ref": "#/$defs/identifier"
        },
        "workflows": {
          "$ref": "#/$defs/identifier_list"
        },
        "layouts": {
          "oneOf": [
            {
              "const": "all"
            },
            {
              "$ref": "#/$defs/identifier_list"
            }
          ]
        },
        "tolerance_profile": {
          "$ref": "#/$defs/identifier"
        },
        "layout_comparison_policy": {
          "enum": [
            "fixed_hdf5",
            "mesh_independent"
          ]
        },
        "reference_comparisons": {
          "type": "boolean"
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "openmp",
              "mpi",
              "hybrid",
              "all_pairs"
            ]
          }
        },
        "diagnostics": {
          "enum": [
            "off",
            "summary",
            "equations",
            "detailed"
          ]
        }
      },
      "dependentRequired": {
        "relations": [
          "tolerance_profile"
        ],
        "tolerance_profile": [
          "relations"
        ],
        "layout_comparison_policy": [
          "relations"
        ]
      }
    }
  }
}
