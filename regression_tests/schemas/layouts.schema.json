{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wave46/MHDG/develop/regression_tests/schemas/layouts.schema.json",
  "title": "MHDG regression execution layouts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layouts"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:serial_omp[1-9][0-9]*|mpi[1-9][0-9]*_omp[1-9][0-9]*)$"
      }
    }
  }
}
