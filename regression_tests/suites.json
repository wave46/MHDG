{
  "schema_version": 2,
  "defaults": {
    "case": "diverted_case",
    "layout": "mpi4_omp4"
  },
  "profiles": {
    "routine": {
      "description": "Fast diverted warm golden and adaptive execution smoke",
      "checks": [
        {"suite": "warm"},
        {"suite": "adaptive"}
      ]
    },
    "routine-extended": {
      "description": "Diverted warm golden and fixed/adaptive parallel checks with diagnostics",
      "checks": [
        {"suite": "warm"},
        {"suite": "parallel"}
      ]
    },
    "full": {
      "description": "Extended checks plus full cold runs for both topologies and distinct limited features",
      "include": ["routine-extended"],
      "checks": [
        {"suite": "cold"},
        {"suite": "warm", "case": "legacy_case"},
        {"suite": "cold", "case": "legacy_case"},
        {"suite": "fixed_cold", "case": "legacy_case"},
        {"suite": "neutrals"},
        {"suite": "neutral_parallel"},
        {"suite": "sources"},
        {"suite": "source_cold"},
        {"suite": "neutralgamma"},
        {"suite": "impurities"},
        {"suite": "initialization"}
      ]
    }
  },
  "suites": {
    "bootstrap": {
      "description": "Three-stage adaptive bootstrap convergence; candidate evidence before new goldens",
      "workflows": ["bootstrap_adaptive"],
      "reference_comparisons": false
    },
    "warm": {
      "description": "Warm golden regression with transport_1d in the production hybrid layout",
      "workflows": ["warm"]
    },
    "warm_parallelism": {
      "description": "Warm restart across serial, MPI, and OpenMP layouts",
      "workflows": ["warm"],
      "layouts": "all"
    },
    "parallel": {
      "description": "Short fixed/adaptive OpenMP, MPI and hybrid consistency",
      "workflows": ["cold_step_fixed", "cold_step_adaptive"],
      "tolerance_profile": "race_step",
      "relations": ["openmp", "mpi", "hybrid"],
      "diagnostics": "detailed"
    },
    "cold": {
      "description": "Full seven-stage adaptive cold regression",
      "workflows": ["cold_adaptive"]
    },
    "cold_matrix": {
      "description": "Cold workflows with golden and all-pairs layout checks",
      "workflows": ["cold_fixed", "cold_adaptive"],
      "tolerance_profile": "cold_cross_layout",
      "layout_comparison_policy": "fixed_hdf5",
      "reference_comparisons": true,
      "relations": ["all_pairs"]
    },
    "neutrals": {
      "description": "Independent source relocation, neutral pressure, projection, and limiter goldens",
      "workflows": [
        "warm_neutral_sources_in_elements",
        "warm_neutral_pressure",
        "warm_neutral_perpendicular",
        "warm_neutral_limiter_fixed",
        "warm_neutral_limiter_ti"
      ],
      "case": "legacy_case"
    },
    "neutral_parallel": {
      "description": "Short parallel checks for distinct neutral features",
      "workflows": [
        "race_neutral_sources_in_elements",
        "race_neutral_pressure",
        "race_neutral_perpendicular",
        "race_neutral_limiter_fixed",
        "race_neutral_limiter_ti"
      ],
      "tolerance_profile": "neutral_feature_race_step",
      "relations": ["openmp", "mpi", "hybrid"],
      "case": "legacy_case"
    },
    "neutralgamma": {
      "description": "One-step two-Newton-iteration NeutralGamma OpenMP and detailed-balance check",
      "workflows": ["cold_step_neutralgamma"],
      "tolerance_profile": "race_step",
      "relations": ["openmp"],
      "case": "legacy_case",
      "diagnostics": "detailed"
    },
    "sources": {
      "description": "Source-placement diagnostics on short fixed/adaptive parallel runs",
      "workflows": ["cold_step_fixed_neutral_sources_in_elements", "cold_step_adaptive_neutral_sources_in_elements"],
      "tolerance_profile": "race_step",
      "relations": ["openmp", "mpi", "hybrid"],
      "case": "legacy_case",
      "diagnostics": "detailed"
    },
    "source_cold": {
      "description": "Full source-relocated adaptive cold execution",
      "workflows": ["cold_adaptive_neutral_sources_in_elements"],
      "reference_comparisons": false,
      "case": "legacy_case"
    },
    "impurities": {
      "description": "Disabled, nitrogen and mixed-impurity warm goldens; tungsten is covered by warm",
      "workflows": ["warm_impurity_off", "warm_impurity_n", "warm_impurity_nw"],
      "case": "legacy_case"
    },
    "initialization": {
      "description": "Analytical initialization and stored-field compatibility on real limited geometry",
      "workflows": ["cold_step_impurity_off", "cold_step_stored_field"],
      "reference_comparisons": false,
      "case": "legacy_case",
      "layouts": ["serial_omp1"]
    },




    "fixed_cold": {
      "description": "Full seven-stage fixed-mesh cold regression",
      "workflows": ["cold_fixed"]
    },
    "adaptive": {
      "description": "Short adaptive execution smoke; field/mesh parity is checked by parallel",
      "workflows": ["cold_step_adaptive"],
      "reference_comparisons": false
    }
  }
}
