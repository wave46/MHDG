# Copy this file outside Git, fill in absolute local paths, and pass it to the
# regression commands with --settings. Do not add physical case details or
# credentials to a tracked settings file.

MHDG_REGRESSION_SETTINGS_VERSION=1

MHDG_REGRESSION_DATA_ROOT=/absolute/path/to/external/case_bundle
MHDG_REGRESSION_RUN_ROOT=/absolute/path/to/regression/scratch

# Optional. Build output otherwise goes under MHDG_REGRESSION_RUN_ROOT/builds.
MHDG_REGRESSION_BUILD_ROOT=/absolute/path/to/regression/builds
MHDG_REGRESSION_BUILD_JOBS=8

# Required for prebuilt runs; generated automatically by --build.
MHDG_SERIAL_EXECUTABLE=/absolute/path/to/serial/solver
MHDG_PARALLEL_EXECUTABLE=/absolute/path/to/parallel/solver

# The runner uses Open MPI --bind-to and --map-by options.
MHDG_MPI_LAUNCHER=mpirun.openmpi
MHDG_ENVIRONMENT_SCRIPT=/absolute/path/to/lib/Make.inc/init_vars_libs.sh

# Optional for prebuilt runs; generated automatically by --build.
MHDG_SOLVER_REVISION=
MHDG_BUILD_DESCRIPTION=
