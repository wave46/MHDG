&TRANSPORT_MODEL_1D_LST
  ! Reference radii used by the mixed Bohm / gyro-Bohm model.
  ! rho_core and rho_edge define the two points entering Delta_Te.
  rho_core = 0.8
  rho_edge = 0.99

  ! Diffusion replacement is usually intended only for the confined region.
  ! The 1D diffusion model is fully applied below
  ! rho_diffusion_model_max - rho_blend_width, then smoothly ramps to zero
  ! over that interval, and is exactly zero for
  ! rho_pol_norm >= rho_diffusion_model_max.
  rho_diffusion_model_max = 0.99

  ! Topology regions in which reduced 1D transport is applied.
  ! legacy_all_regions keeps the historical behavior.
  ! core_and_main_sol excludes private flux while allowing rho_pol_norm > 1.
  ! core_only restricts reduction, diffusion, and pinch to the confined core.
  transport_region_policy = 'legacy_all_regions'

  ! Mixed Bohm / gyro-Bohm coefficients.
  ! Reference: JETTO/NTCC mixed Bohm / gyro-Bohm model description.

  c_bohm_i = 1.6e-4
  c_gyrobohm_i = 1.75e-2
  c_bohm_e = 8.e-5
  c_gyrobohm_e = 3.5e-2
  c_bohm_n = 1.0
  prandtl = 1.0

  ! Pinch model selector.
  ! 1 -> Militello collisionality-dependent pinch
  !      Reference: E. Militello-Asp et al., NF 2022-style suppression factor.
  ! 2 -> Polevoi-style geometric pinch baseline
  !      with v_pinch = C * D * rho_pol_norm / a_minor.
  !      Reference for integrated-model usage: Polevoi et al., Nuclear Fusion (2020).
  ! 3 -> Constant pinch for steady-state checks.
  !      Positive values mean outward pinch (along increasing minor radius);
  !      negative values mean inward pinch.
  pinch_model = 2

  ! Pinch coefficient C. Positive C follows the outward radial convention.
  ! Use negative C for inward pinch.
  ! A single C is currently used for both model 1 and model 2.
  c_pinch = 0.5

  ! Collisionality threshold used only by the Militello suppression factor.
  nu_th = 0.04

  ! Constant pinch speed [m/s] used only when pinch_model = 3.
  ! Positive is outward, negative is inward.
  vpinch_const_phys = -1.0

  ! Smooth pinch window parameters in rho_pol_norm.
  ! The pinch is zero on axis, ramps to full value over
  ! rho_pinch_axis_width, stays fully active in the middle region, then
  ! ramps back to zero over rho_pinch_edge_width before
  ! rho_pol_norm = rho_pinch_model_max.
  ! It is exactly zero for rho_pol_norm >= rho_pinch_model_max.
  rho_pinch_axis_width = 0.02
  rho_pinch_model_max = 0.99
  rho_pinch_edge_width = 0.03

  ! Width of the cubic smoothstep diffusion ramp near the outer cutoff.
  rho_blend_width = 0.03

  ! Minimum transport coefficients in physical units [m^2/s].
  ! They are adimensionalized internally before use.
  diff_n_min_phys = 0.01
  diff_u_min_phys = 0.01
  diff_e_min_phys = 0.01
  diff_ee_min_phys = 0.01
/
