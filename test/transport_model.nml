&TRANSPORT_MODEL_1D_LST
  ! Reference radii used by the 1D core transport model.
  ! rho_core enters Delta_Te, rho_edge is the edge reference point.
  rho_core = 0.8
  rho_edge = 0.99

  ! Transport model is expected to be valid only in the confined region.
  ! Keep coefficients computed on the full 1D grid; apply this cutoff later
  ! when interpolating transport back to local points.
  rho_model_max = 0.99

  ! Mixed Bohm / gyro-Bohm coefficients.
  ! Reference: JETTO/NTCC mixed_bohm_gyro_bohm model description.

  c_bohm_i = 1.6e-4
  c_gyrobohm_i = 1.75e-2
  c_bohm_e = 8.e-5
  c_gyrobohm_e = 3.5e-2
  c_bohm_n = 1.0
  prandtl = 1.0

  ! Pinch model selector:
  ! 1 -> Militello collisionality-dependent pinch
  !      Reference: E. Militello-Asp et al., NF 2022-style suppression factor.
  ! 2 -> Polevoi-style geometric pinch baseline
  !      with v_pinch = C * D * r / a^2.
  !      Reference for integrated-model usage: Polevoi et al., Nuclear Fusion (2020).
  pinch_model = 2

  ! Pinch coefficient C.
  ! For benchmarking we currently use one shared coefficient for both models,
  ! but in practice the Polevoi-style baseline may need a different tuned value.
  c_pinch = 0.5

  ! Collisionality threshold used only by the Militello suppression factor.
  nu_th = 0.04

  ! Width of the smooth core-to-edge transport transition in rho.
  rho_blend_width = 0.03

  ! Minimum transport coefficients in physical units [m^2/s].
  ! They are adimensionalized internally before use.
  diff_n_min_phys = 1e-2
  diff_u_min_phys = 1e-2
  diff_e_min_phys = 1e-2
  diff_ee_min_phys = 1e-2
/
